<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: warm amber TV highlight -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="2.5dp" android:color="#F59E0B" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Selected state: vibrant cyan accent -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0284C7" />
            <stroke android:width="1.5dp" android:color="#7DD3FC" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Normal state: clean dark surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: radiant electric cyan border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A8A" />
            <stroke android:width="2.5dp" android:color="#00F2FE" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Selected state: royal indigo accent -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2563EB" />
            <stroke android:width="1.5dp" android:color="#93C5FD" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <!-- Normal state: dark slate pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131B2E" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>

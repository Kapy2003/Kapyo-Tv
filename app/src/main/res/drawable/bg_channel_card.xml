<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: electric cyan glowing border + elevated royal blue backdrop -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A8A" />
            <stroke android:width="3dp" android:color="#00F2FE" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#172554" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal state: deep cinematic slate surface with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1527" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- BROWSE CONTAINER (TV 10-foot Safe-Area Margins: 48dp horizontal, 24dp vertical) -->
    <LinearLayout
        android:id="@+id/container_browse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp">

        <!-- TOP BAR: Title, Country Badge, Search, Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Brand Logo Group: KAPYO + TV badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="KAPYO"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tv_brand_badge"
                    android:letterSpacing="0.05"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="TV"
                    android:textColor="#050811"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Country Indicator Chip (Focusable) -->
            <TextView
                android:id="@+id/tv_top_country_badge"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_chip_country"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@id/et_search"
                android:nextFocusDown="@id/rv_languages"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="India"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Fast Search Input for TV -->
            <EditText
                android:id="@+id/et_search"
                android:layout_width="220dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_search_field"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusLeft="@id/tv_top_country_badge"
                android:nextFocusRight="@id/btn_settings"
                android:nextFocusDown="@id/rv_languages"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_muted"
                android:textSize="13sp" />

            <!-- Settings Button -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_category"
                android:focusable="true"
                android:nextFocusLeft="@id/et_search"
                android:nextFocusDown="@id/rv_languages"
                android:text="@string/settings"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ROW 1: LANGUAGES HORIZONTAL FILTER (Hindi, Tamil, Telugu, English, etc.) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_languages"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nextFocusUp="@id/et_search"
            android:nextFocusDown="@id/rv_categories"
            android:orientation="horizontal" />

        <!-- ROW 2: CATEGORIES / GENRES FOR SELECTED LANGUAGE (All, News, Movies, Kids, etc.) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nextFocusUp="@id/rv_languages"
            android:nextFocusDown="@id/rv_channels"
            android:orientation="horizontal" />

        <!-- CHANNELS GRID -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nextFocusUp="@id/rv_categories" />

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/pb_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Empty / Error Text -->
            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- FULLSCREEN PLAYER CONTAINER -->
    <FrameLayout
        android:id="@+id/container_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/player_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Buffering Spinner -->
        <ProgressBar
            android:id="@+id/player_buffering"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- AUTO-HIDING 3-SECOND OSD CHANNEL BANNER -->
        <LinearLayout
            android:id="@+id/player_osd_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="32dp"
            android:background="@drawable/bg_overlay_banner"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_osd_channel_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_card_focused"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_channel_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textDirection="locale"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/tv_badge_bg"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/tv_badge_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#1E293B"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Navigation Helper Tip -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="◄ / ►  Switch Channel   •   OK  Show Info   •   Back  Return to Browse"
                android:textColor="@color/tv_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- STREAM UNAVAILABLE / AUTO-RETRY OVERLAY -->
        <LinearLayout
            android:id="@+id/player_error_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_unavailable"
                android:textColor="@color/tv_error"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auto_retry_notice"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_error_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/next_channel_prompt"
                android:textColor="@color/tv_card_focused"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
